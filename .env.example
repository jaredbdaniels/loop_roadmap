# Auto-provisioned by Neon (via the Vercel Storage dashboard) — pulled with `vercel env pull`
POSTGRES_URL=

# Local dev only: set to 1 to bypass Google login and sign in as a dev
# CampMinder user. Ignored in production. Leave unset once OAuth is configured.
DEV_AUTH=1

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app. Localhost in dev; set to the deployed URL in prod.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features (Phase 1). Master switch: unset/0 hides every AI affordance and
# makes /api/ai/* return 503. Set to 1 to enable.
AI_FEATURES=0
# Which provider the model wrapper (src/lib/ai/model.ts) uses: "openai" (default)
# or "anthropic" (requires installing @ai-sdk/anthropic + ANTHROPIC_API_KEY).
AI_PROVIDER="openai"
# Provider key for the active AI_PROVIDER. Get an OpenAI key from
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Azure DevOps sync (the "Sync ADO" button / POST /api/sync/ado).
# The hosted app calls the ADO REST API directly — it cannot use the Claude MCP
# connector. Mint a Personal Access Token scoped to Work Items (Read) at
# https://dev.azure.com/CampMinderLLC/_usersSettings/tokens and set it here.
# Without ADO_PAT the sync route returns 501 and the rest of the app is unaffected.
ADO_PAT=
# Overrides (defaults shown). Project keeps the legacy capitalization on purpose.
ADO_ORG="CampMinderLLC"
ADO_PROJECT="CampMinder"

# Aha! Ideas → Loop capture webhook (POST /api/webhooks/aha).
# Aha! pushes new CX ideas here; each lands as a draft in the Capture inbox for
# human review. A webhook has no Better Auth session, so a shared secret is the
# auth boundary — generate one (openssl rand -base64 32) and set it both here and
# on the Aha! automation (as an x-aha-secret header, a Bearer token, or a
# ?secret= query param on the webhook URL). Without it the route returns 501 and
# the rest of the app is unaffected.
AHA_WEBHOOK_SECRET=
# Optional server-side CX backstop: a comma-separated allow-list of Aha! category
# / tag names to accept. Prefer scoping the Aha! automation to the CX portal and
# leaving this unset (unset = accept every idea Aha! sends).
# AHA_CX_CATEGORY="CX,Customer Experience"
# Your Aha! subdomain (the <name> in <name>.aha.io). Not required for the webhook
# ingest path; reserved for a future REST pull/enrichment.
# AHA_SUBDOMAIN=
# AHA_API_KEY=

# Auto-set by Vercel in production; localhost in dev
NEXT_PUBLIC_APP_URL="http://localhost:3000"
